# =============================================================================
# Limbu Monorepo — Master Environment Reference
# =============================================================================
#
# DO NOT commit real secrets. Copy app-specific templates instead:
#
#   apps/web/.env.local.example      → apps/web/.env.local
#   apps/admin/.env.local.example    → apps/admin/.env.local
#   apps/api/.env.example            → apps/api/.env.local
#   apps/worker/.env.example         → apps/worker/.env
#   packages/db/.env.example         → packages/db/.env
#
# See ENV_SETUP.md for full audit, shared-variable rules, and security notes.
# =============================================================================

# ── Database (PostgreSQL / Neon) ───────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/limbu?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/limbu?sslmode=require"

# ── Auth.js / NextAuth v5 ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# MUST be identical across web, api, and admin.
AUTH_SECRET="replace-with-32-byte-random-secret"
NEXTAUTH_URL="https://app.limbu.ai"
AUTH_URL=""
AUTH_TRUST_HOST="true"

# ── OAuth (optional per provider) ──────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Inter-service URLs ───────────────────────────────────────────────────────
API_URL="http://localhost:3002"
API_INTERNAL_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3003"
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI providers (≥1 required for chat; OpenAI required for RAG embeddings) ─
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY=""

# ── GMB Integrations ─────────────────────────────────────────────────────────
INTEGRATION_MOCK_GOOGLE="true"
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REDIRECT_URI="http://localhost:3002/api/integrations/google/callback"
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=""

# ── RAG / Qdrant ─────────────────────────────────────────────────────────────
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="limbu_knowledge"
RAG_UPLOAD_DIR=".uploads/knowledge"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_CHUNK_SIZE="1000"
RAG_CHUNK_OVERLAP="200"
RAG_MAX_FILE_SIZE_MB="25"
RAG_WORKER_SECRET=""
RAG_WORKER_BATCH_SIZE="5"

# ── Workflows ────────────────────────────────────────────────────────────────
WORKFLOW_WORKER_SECRET=""
WORKFLOW_WORKER_BATCH_SIZE="10"
WORKFLOW_MAX_LOOP_ITERATIONS="100"

# ── Stripe billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_MOCK_STRIPE="false"
BILLING_DEFAULT_TRIAL_DAYS="14"
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_ANNUAL=""

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Limbu <noreply@limbu.ai>"

# ── Notifications / Web Push ─────────────────────────────────────────────────
NOTIFICATION_WORKER_SECRET=""
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_MOCK_EMAIL="false"
NOTIFICATION_MOCK_PUSH="false"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@limbu.ai"

# ── Background worker service ────────────────────────────────────────────────
WORKER_PORT="3001"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_POLL_ENABLED="true"

# ── Runtime (set by platform; do not set manually in most cases) ─────────────
NODE_ENV="development"
API_PORT="3002"
