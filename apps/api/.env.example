# =============================================================================
# @limbu/api — Backend API service (port 3002)
# Copy to: apps/api/.env.local
#
# This service executes most business logic. It needs the same secrets as
# apps/web for auth, AI, billing, RAG, and notifications.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"
DIRECT_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# AUTH_SECRET must match web and admin.
# NEXTAUTH_URL is the public web app URL (cookie/session context), not :3002.
AUTH_SECRET="limbu-dev-secret-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GEMINI_API_KEY=""

# ── GMB Integrations ─────────────────────────────────────────────────────────
INTEGRATION_MOCK_GOOGLE="true"
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
GOOGLE_BUSINESS_REDIRECT_URI="http://localhost:3002/api/integrations/google/callback"
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=""

# ── RAG / Qdrant ─────────────────────────────────────────────────────────────
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="limbu_knowledge"
RAG_UPLOAD_DIR=".uploads/knowledge"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_CHUNK_SIZE="1000"
RAG_CHUNK_OVERLAP="200"
RAG_MAX_FILE_SIZE_MB="25"
RAG_WORKER_SECRET="dev-rag-secret"
RAG_WORKER_BATCH_SIZE="5"

# ── Workflows ────────────────────────────────────────────────────────────────
WORKFLOW_WORKER_SECRET="dev-workflow-secret"
WORKFLOW_WORKER_BATCH_SIZE="10"
WORKFLOW_MAX_LOOP_ITERATIONS="100"

# ── Stripe billing ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BILLING_MOCK_STRIPE="true"
BILLING_DEFAULT_TRIAL_DAYS="14"
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_ANNUAL=""

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Limbu <noreply@limbu.ai>"

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFICATION_WORKER_SECRET="dev-notification-secret"
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_MOCK_EMAIL="false"
NOTIFICATION_MOCK_PUSH="true"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@limbu.ai"

# ── Documented but unused in code (port set via package.json --port 3002) ───
API_PORT="3002"
