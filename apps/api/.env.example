# @limbu/api — copy from apps/web/.env.example
# API service listens on port 3002 by default.

API_PORT="3002"

# Shared with @limbu/web — same DATABASE_URL, AUTH_SECRET, provider keys, etc.
DATABASE_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"
DIRECT_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"
AUTH_SECRET="limbu-dev-secret-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
