# =============================================================================
# Production — Neon PostgreSQL
# =============================================================================

# Pooled — app runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct — Prisma migrations (packages/db uses the same vars)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-byte-random-secret"
NEXTAUTH_URL="https://app.limbu.ai"
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# AI providers (at least one required for chat)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
# Alias supported by @limbu/ai-core
GEMINI_API_KEY=""

# RAG / Vector search
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="limbu_knowledge"
RAG_UPLOAD_DIR=".uploads/knowledge"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_WORKER_SECRET=""
RAG_MAX_FILE_SIZE_MB="25"

# Workflow engine
WORKFLOW_WORKER_SECRET=""
WORKFLOW_WORKER_BATCH_SIZE="10"
WORKFLOW_MAX_LOOP_ITERATIONS="100"

# Stripe Billing — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Set BILLING_MOCK_STRIPE=true for local dev without Stripe
BILLING_MOCK_STRIPE="false"
BILLING_DEFAULT_TRIAL_DAYS="14"
# Stripe Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_ANNUAL=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_ANNUAL=""

# Email (production SMTP provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Limbu <noreply@limbu.ai>"

# Notifications
NOTIFICATION_WORKER_SECRET=""

# Worker service (Phase 1)
WORKER_PORT="3001"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_POLL_ENABLED="true"
RAG_WORKER_BATCH_SIZE="5"
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_MOCK_EMAIL="false"
NOTIFICATION_MOCK_PUSH="false"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@limbu.ai"

# API service (Phase 3)
API_URL="http://localhost:3002"
API_INTERNAL_URL="http://localhost:3002"

# Admin console (Phase 4) — super-admin link from dashboard
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3003"
