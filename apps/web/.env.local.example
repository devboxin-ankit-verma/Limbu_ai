# =============================================================================
# @limbu/web — Local development (port 3000)
# Copy to: apps/web/.env.local
# =============================================================================

# ── Database (Docker: docker compose --profile local up -d postgres) ────────
DATABASE_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"
DIRECT_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"

# ── Auth.js (must match apps/api and apps/admin) ─────────────────────────────
AUTH_SECRET="limbu-dev-secret-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── API proxy (@limbu/api on port 3002) ──────────────────────────────────────
API_URL="http://localhost:3002"
API_INTERNAL_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3003"

# ── AI (set at least one for chat; OpenAI required for RAG) ──────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# ── RAG / Qdrant (local Qdrant or Docker) ────────────────────────────────────
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="limbu_knowledge"
RAG_UPLOAD_DIR=".uploads/knowledge"
RAG_WORKER_SECRET="dev-rag-secret"

# ── Workflows ────────────────────────────────────────────────────────────────
WORKFLOW_WORKER_SECRET="dev-workflow-secret"

# ── Billing (mock Stripe locally) ────────────────────────────────────────────
BILLING_MOCK_STRIPE="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (Mailpit: docker compose up -d mailpit → http://localhost:8025) ────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
EMAIL_FROM="Limbu <noreply@limbu.ai>"
NOTIFICATION_MOCK_EMAIL="false"

# ── Notifications worker ─────────────────────────────────────────────────────
NOTIFICATION_WORKER_SECRET="dev-notification-secret"
NOTIFICATION_MOCK_PUSH="true"

# ── Worker service (optional — run npm run dev:worker separately) ───────────
WORKER_PORT="3001"
WORKER_POLL_ENABLED="true"
