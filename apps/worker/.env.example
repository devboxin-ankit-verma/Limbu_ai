# =============================================================================
# @limbu/worker — Background job processor (port 3001)
# Copy to: apps/worker/.env
#
# Processes workflow, RAG ingest, and notification queues via HTTP endpoints
# and optional background polling. Secrets must match apps/api.
# =============================================================================

# ── Database (required — job queue lives in PostgreSQL) ──────────────────────
DATABASE_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"

# ── Worker HTTP server ───────────────────────────────────────────────────────
WORKER_PORT="3001"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_POLL_ENABLED="true"

# ── Worker authentication (must match API route guards) ──────────────────────
WORKFLOW_WORKER_SECRET="dev-workflow-secret"
RAG_WORKER_SECRET="dev-rag-secret"
NOTIFICATION_WORKER_SECRET="dev-notification-secret"

# ── Batch sizes ──────────────────────────────────────────────────────────────
WORKFLOW_WORKER_BATCH_SIZE="10"
RAG_WORKER_BATCH_SIZE="5"
NOTIFICATION_WORKER_BATCH_SIZE="25"

# ── RAG job execution (embeddings) ───────────────────────────────────────────
OPENAI_API_KEY=""
QDRANT_URL="http://127.0.0.1:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="limbu_knowledge"
RAG_UPLOAD_DIR=".uploads/knowledge"
RAG_EMBEDDING_MODEL="text-embedding-3-small"

# ── Notification job execution (email) ───────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
EMAIL_FROM="Limbu <noreply@limbu.ai>"
NOTIFICATION_MOCK_EMAIL="false"
NOTIFICATION_MOCK_PUSH="true"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@limbu.ai"

# ── Workflow job execution (AI steps inherit ai-core keys) ───────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
