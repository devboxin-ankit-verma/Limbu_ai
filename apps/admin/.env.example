# =============================================================================
# Limbu Admin Console (@limbu/admin-app) — port 3003
# =============================================================================

# Same database as web/api (required for credentials login)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — must match apps/web and apps/api
AUTH_SECRET="replace-with-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3003"
AUTH_TRUST_HOST="true"

# OAuth (optional — credentials login works without these)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Backend API service — admin UI proxies /api/admin/* here
API_URL="http://localhost:3002"

# Link back to main product app (AdminShell footer)
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3000"
