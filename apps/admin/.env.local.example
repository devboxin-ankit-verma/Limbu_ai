# =============================================================================
# @limbu/admin-app — Local development (port 3003)
# Copy to: apps/admin/.env.local
# =============================================================================

# ── Database (same as web/api) ───────────────────────────────────────────────
DATABASE_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"
DIRECT_URL="postgresql://limbu:limbu@localhost:5433/limbu?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────────────────
# AUTH_SECRET must match web and api.
# NEXTAUTH_URL must be the admin app origin (port 3003), not web (3000).
AUTH_SECRET="limbu-dev-secret-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3003"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Backend API (admin UI proxies /api/admin/* here) ───────────────────────
API_URL="http://localhost:3002"
API_INTERNAL_URL="http://localhost:3002"

# ── Client-exposed link back to product app ──────────────────────────────────
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3000"
