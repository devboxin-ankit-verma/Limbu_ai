# =============================================================================
# Production — Neon PostgreSQL (default)
# Copy to .env and fill in values from https://console.neon.tech
# =============================================================================

# Pooled connection — use for app runtime (Prisma Client, Next.js)
# Neon dashboard → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection — use for migrations only (Prisma Migrate)
# Neon dashboard → Connection Details → "Direct connection"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
