  granted     Boolean
  ip          String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@map("consent_records")
}

model DataExportRequest {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      DataExportStatus @default(pending)
  downloadUrl String?          @map("download_url")
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("data_export_requests")
}

model AccountDeletionRequest {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  status          DeletionRequestStatus @default(pending)
  scheduledPurgeAt DateTime?            @map("scheduled_purge_at") @db.Timestamptz
  cancelledAt     DateTime?             @map("cancelled_at") @db.Timestamptz
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletion_requests")
}

// =============================================================================
// DOMAIN 14: PLATFORM & OPERATIONS
// =============================================================================

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  defaultValue Boolean  @default(false) @map("default_value")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  overrides OrgFeatureOverride[]

  @@map("feature_flags")
}

model OrgFeatureOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  flagKey        String   @map("flag_key")
  value          Boolean
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureFlag  FeatureFlag  @relation(fields: [flagKey], references: [key])

  @@unique([organizationId, flagKey])
  @@map("org_feature_overrides")
}

model ScheduledReport {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  frequency      String
  recipients     String[]
  template       String?
  nextRunAt      DateTime? @map("next_run_at") @db.Timestamptz
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("scheduled_reports")
}

model JobDeadLetter {
  id             String              @id @default(uuid()) @db.Uuid
  queueName      String              @map("queue_name")
  jobId          String              @map("job_id")
  workspaceId    String?             @map("workspace_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  payload        Json
  error          String              @db.Text
  status         JobDeadLetterStatus @default(open)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz

  @@index([queueName, status])
  @@map("job_dead_letters")
}
