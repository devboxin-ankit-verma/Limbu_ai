  createdBy        User?                  @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  template         WorkflowTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  publishedVersion WorkflowVersion?       @relation("PublishedWorkflowVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  steps            WorkflowStep[]
  runs             WorkflowRun[]
  versions         WorkflowVersion[]      @relation("WorkflowVersions")
  jobs             WorkflowExecutionJob[]

  @@index([workspaceId, status])
  @@index([organizationId, status])
  @@map("workflows")
}

