// =============================================================================
// DOMAIN 1: IDENTITY & AUTHENTICATION
// =============================================================================

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String
  name         String?
  avatarUrl    String?      @map("avatar_url")
  authProvider  AuthProvider @default(email) @map("auth_provider")
  passwordHash  String?      @map("password_hash")
  emailVerified DateTime?    @map("email_verified") @db.Timestamptz
  mfaEnabled    Boolean      @default(false) @map("mfa_enabled")
  isSuperAdmin  Boolean      @default(false) @map("is_super_admin")
  locale       String       @default("en")
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  sessions                Session[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  mfaSecret              MfaSecret?
  oauthStates            OAuthState[]
  organizationMembers    OrganizationMember[]
  workspaceMembers       WorkspaceMember[]
  ownedOrganizations     Organization[]         @relation("OrganizationOwner")
  aiThreads              AiThread[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  emailDeliveries        EmailDelivery[]
  pushSubscriptions      PushSubscription[]
  notificationDeliveries NotificationDelivery[]
  notificationJobs       NotificationJob[]
  userAcceptances        UserAcceptance[]
  consentRecords         ConsentRecord[]
  dataExportRequests     DataExportRequest[]
  accountDeletionRequests AccountDeletionRequest[]
  onboardingProgress     OnboardingProgress[]
  knowledgeBases         KnowledgeBase[]
  uploadedKnowledgeDocs  KnowledgeDocument[]    @relation("KnowledgeDocumentUploader")
  agentRuns              AgentRun[]
  workflowsCreated       Workflow[]             @relation("WorkflowCreator")
  workflowRuns           WorkflowRun[]          @relation("WorkflowRunUser")
  postsCreated           Post[]                 @relation("PostCreator")
  postVersionsEdited     PostVersion[]          @relation("PostVersionEditor")
  postApprovalsRequested PostApproval[]         @relation("ApprovalRequester")
  postApprovalsReviewed  PostApproval[]         @relation("ApprovalReviewer")
  auditLogsActed         AuditLog[]             @relation("AuditActor")
  impersonationsAsAdmin  ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  ip        String?
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @map("token_hash")
  rotatedFrom String?  @map("rotated_from") @db.Uuid
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model OAuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  accessToken       String?      @map("access_token") @db.Text
  refreshToken      String?      @map("refresh_token") @db.Text
  expiresAt         DateTime?    @map("expires_at") @db.Timestamptz
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model MfaSecret {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  secretEncrypted Bytes @map("secret_encrypted")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model OAuthState {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  stateToken  String   @unique @map("state_token")
  provider    IntegrationProvider
  redirectUri String   @map("redirect_uri")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("oauth_states")
}

model ImpersonationSession {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @map("admin_id") @db.Uuid
  targetUserId String    @map("target_user_id") @db.Uuid
  reason       String
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt      DateTime? @map("ended_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  admin      User @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  targetUser User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@map("impersonation_sessions")
}

model OnboardingProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  step           Int       @default(1)
  data           Json      @default("{}")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("onboarding_progress")
}

// =============================================================================
// DOMAIN 2: TENANCY & ACCESS CONTROL
// =============================================================================

model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  planTier         PlanTier  @default(free) @map("plan_tier") // denormalized cache — source: Subscription
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  ownerId          String    @map("owner_id") @db.Uuid
  status           OrgStatus @default(active)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  owner              User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members            OrganizationMember[]
  workspaces         Workspace[]
  invitations        Invitation[]
  subscriptions      Subscription[]
  creditBalance      CreditBalance?
  creditTransactions CreditTransaction[]
  aiUsageRecords     AiUsageRecord[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  auditLogs          AuditLog[]
  invoices           Invoice[]
  dunningEvents      DunningEvent[]
  referralsMade      Referral[]           @relation("ReferrerOrg")
  referralsReceived  Referral?            @relation("ReferredOrg")
  featureOverrides   OrgFeatureOverride[]
  contentTemplates   ContentTemplate[]
  onboardingProgress OnboardingProgress[]
  knowledgeBases     KnowledgeBase[]
  workflowTemplates  WorkflowTemplate[]
  usagePeriodSummaries UsagePeriodSummary[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Workspace {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  industry       String?
  timezone       String          @default("UTC")
  status         WorkspaceStatus @default(active)
  settings       Json            @default("{}")
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members               WorkspaceMember[]
  invitationWorkspaces  InvitationWorkspace[]
  approvalPolicy        ApprovalPolicy?
  brandVoiceProfile     BrandVoiceProfile?
  businessProfile       BusinessProfile?
  integrationConnections IntegrationConnection[]
  posts                 Post[]
  postMedia             PostMedia[]
  mediaFolders          MediaFolder[]
  recurringPostRules    RecurringPostRule[]
  reviews               Review[]
  inboxMessages         InboxMessage[]
  gbpQuestions          GbpQuestion[]
  aiThreads             AiThread[]
  aiGenerations         AiGeneration[]
  knowledgeBases        KnowledgeBase[]
  knowledgeDocuments    KnowledgeDocument[]
  workflows             Workflow[]
  agents                Agent[]
  analyticsSnapshots    AnalyticsSnapshot[]
  scheduledReports      ScheduledReport[]
  reviewAlertRules      ReviewAlertRule[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MemberStatus  @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  orgRole        OrgRole          @map("org_role")
  token          String           @unique
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaces   InvitationWorkspace[]

  @@index([organizationId, email])
  @@map("invitations")
}

model InvitationWorkspace {
  id           String        @id @default(uuid()) @db.Uuid
  invitationId String        @map("invitation_id") @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  role         WorkspaceRole
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([invitationId, workspaceId])
  @@map("invitation_workspaces")
}

model ApprovalPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @unique @map("workspace_id") @db.Uuid
  requireApproval   Boolean  @default(false) @map("require_approval")
  approverRoles     String[] @map("approver_roles")
  autoApproveRoles  String[] @map("auto_approve_roles")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("approval_policies")
}

model BusinessProfile {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  name        String?
  phone       String?
  website     String?
  address     Json?
  hours       Json?
  categories  String[]
  metadata    Json     @default("{}")
  syncedAt    DateTime? @map("synced_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// =============================================================================
// DOMAIN 3: INTEGRATIONS
// =============================================================================

model IntegrationConnection {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  provider          IntegrationProvider
  externalAccountId String?             @map("external_account_id")
  status            IntegrationStatus   @default(pending)
  lastSyncAt        DateTime?           @map("last_sync_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential?
  locations    ConnectedLocation[]
  syncRuns     IntegrationSyncRun[]

  @@index([workspaceId, provider])
  @@map("integration_connections")
}

model IntegrationCredential {
  id               String   @id @default(uuid()) @db.Uuid
  connectionId     String   @unique @map("connection_id") @db.Uuid
  encryptedAccess  Bytes?   @map("encrypted_access")
  encryptedRefresh Bytes?   @map("encrypted_refresh")
  scopes           String[]
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("integration_credentials")
}

model ConnectedLocation {
  id                 String   @id @default(uuid()) @db.Uuid
  connectionId       String   @map("connection_id") @db.Uuid
  externalLocationId String   @map("external_location_id")
  name               String?
  address            String?
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalLocationId])
  @@map("connected_locations")
}

model IntegrationSyncRun {
  id             String        @id @default(uuid()) @db.Uuid
  connectionId   String        @map("connection_id") @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  type           SyncRunType
  status         SyncRunStatus @default(running)
  recordsSynced  Int           @default(0) @map("records_synced")
  error          String?
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@map("integration_sync_runs")
}

// =============================================================================
// DOMAIN 4: CONTENT & PUBLISHING
// =============================================================================

model Post {
  id                  String     @id @default(uuid()) @db.Uuid
  workspaceId         String     @map("workspace_id") @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  createdById         String?    @map("created_by_id") @db.Uuid
  contentTemplateId   String?    @map("content_template_id") @db.Uuid
  recurringRuleId     String?    @map("recurring_rule_id") @db.Uuid
  content             Json
  channels            PublishChannel[]
  status              PostStatus @default(draft)
  scheduledAt         DateTime?  @map("scheduled_at") @db.Timestamptz
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contentTemplate ContentTemplate?   @relation(fields: [contentTemplateId], references: [id], onDelete: SetNull)
  recurringRule   RecurringPostRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  versions        PostVersion[]
  publishJobs     PublishJob[]
  approvals       PostApproval[]
  analytics       PostAnalytics[]
  utmLinks        UtmLink[]

  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, status])
  @@map("posts")
}

model PostVersion {
  id             String   @id @default(uuid()) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
