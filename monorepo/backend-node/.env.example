# Application Configuration
APP_NAME=Backend API
APP_VERSION=1.0.0
PORT=8000
DEBUG=false

# Database Configuration (MySQL for Prisma)
DATABASE_URL=mysql://user:password@localhost:3306/share_market

# Redis (optional - for cache/sessions)
# REDIS_URL=redis://localhost:6379

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (include your frontend dev URL; Vite default is 3000 or 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
